# Audio and models — never commit either.
# Recordings are deleted after processing (docs/architecture/privacy.md);
# model weights are downloaded on first run (docs/engineering/environments.md).
*.mp3
*.wav
*.m4a
*.flac
models/
.cache/

# Local data
*.db
*.sqlite3
data/

# Training corpora. Downloaded per machine, never committed: they are large
# (AI Hub 002 alone is ~154GB), they carry their own licences, and GitHub
# rejects files over 100MB. Record where a corpus came from in the module's
# documentation instead. See docs/engineering/environments.md.
dataset/
datasets/
corpus/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Agent working artifacts. Notes, patch drafts and staging directories a Claude
# Code session leaves in the checkout; they belong to the session, not here. A
# file worth keeping goes into docs/ as a document, not in as a by-product.
Claude outputs/
_to_delete/
