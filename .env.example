# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every variable here is documented in docs/engineering/environments.md.

# Unset means production (#408): keep this line in a local checkout.
AUTUNE_ENV=local
AUTUNE_LOG_LEVEL=INFO

AUTUNE_DATABASE_URL=postgresql+psycopg://autune:autune@localhost:5432/autune
AUTUNE_REDIS_URL=redis://localhost:6379/0

# JWT signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTUNE_SECRET_KEY=local-development-only-change-me-in-every-environment

# Encrypts each team's integration credentials at rest. Required outside local.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTUNE_ENCRYPTION_KEY=

# Where the browser is sent back after an OAuth round trip
AUTUNE_WEB_BASE_URL=http://localhost:3000

# Google sign-in (W2). Create an OAuth client in the Google Cloud console and
# register the redirect URI there exactly as set below. Leave blank until wired.
# The redirect URI points at the WEB origin, not the API: the browser reaches
# /api/* through the Next proxy (apps/web/next.config.ts), so the OAuth callback
# must land there too for the session cookie to be first-party.
AUTUNE_GOOGLE_CLIENT_ID=
AUTUNE_GOOGLE_CLIENT_SECRET=
AUTUNE_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Analysis result retention, in days (docs/architecture/privacy.md)
AUTUNE_RETENTION_DAYS=90

# Comma-separated origins apps/api allows via CORS. Empty (default) = no CORS
# headers at all. Only needed for local dev running apps/web's dev server
# against apps/api's, since :3000 and :8000 are different origins to a browser.
AUTUNE_CORS_ALLOWED_ORIGINS=

# --- Integrations (leave blank until the feature is built) ---
AUTUNE_SLACK_BOT_TOKEN=
AUTUNE_SLACK_SIGNING_SECRET=
# Socket mode, local development only
AUTUNE_SLACK_APP_TOKEN=
# Notion and Calendar are configured per team on screen S28 and stored in
# team_integrations, not here. See docs/architecture/data-model.md.

# --- Module A ---
AUTUNE_AUDIO_WHISPER_MODEL=large-v3
AUTUNE_AUDIO_DEVICE=cpu
# Where pyannote runs. Empty follows AUTUNE_AUDIO_DEVICE; cpu, mps, cuda.
# On an accelerator diarization is 14x faster for an identical result, but the
# device above is the transcriber's, and torch may not reach what CTranslate2
# reaches -- an empty value that cannot be used takes CPU and says so in the
# log. Set it to promise the device instead: then it refuses to run without it.
# mps is unverified under a prefork or threaded worker (#329) -- use --pool=solo.
AUTUNE_AUDIO_DIARIZATION_DEVICE=
# Raw audio lives here only while a task runs, then is deleted. Not a synced folder.
AUTUNE_AUDIO_TEMP_DIR=/tmp/autune-audio
AUTUNE_AUDIO_ORPHAN_AFTER_HOURS=6
AUTUNE_AUDIO_HF_TOKEN=
AUTUNE_MODEL_CACHE=~/.cache/autune/models

# --- Module B ---
# Which classifier runs: local (weights in process) | hosted (our own server) | fake
# | llm (a cloud LLM; opt-in, never the default -- see docs/engineering/environments.md
# and #392 before pointing it at a real meeting).
AUTUNE_EXTRACTION_CLASSIFIER_IMPL=local
# Required for local and hosted. Blank: no trained checkpoint is published yet.
# A directory `python -m autune_extraction.training` wrote, or a pinned hub revision
AUTUNE_EXTRACTION_CLASSIFIER_CHECKPOINT=
# Required when CLASSIFIER_IMPL=hosted
AUTUNE_EXTRACTION_CLASSIFIER_ENDPOINT=
# cpu or cuda, for CLASSIFIER_IMPL=local. cuda needs a CUDA torch build
AUTUNE_EXTRACTION_CLASSIFIER_DEVICE=cpu
# For CLASSIFIER_IMPL=llm. Blank key: llm refuses to start. A free-tier key may let
# the provider keep what it is sent -- dummy meetings only. Names said aloud are
# not masked, so they go too (#392).
AUTUNE_EXTRACTION_LLM_API_KEY=
AUTUNE_EXTRACTION_LLM_MODEL=gemini-3.8-flash
# Answers a window when LLM_MODEL stays unavailable. Blank disables the fallback
AUTUNE_EXTRACTION_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
AUTUNE_EXTRACTION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Timeout per request (connect and read), seconds. The shared client's 10 s is too
# short for a thinking model; a window may retry and fall back
AUTUNE_EXTRACTION_LLM_TIMEOUT_SEC=60
# Step 4 (#12): does a commitment/ambiguous utterance actually entail a promise.
# local (weights in process) | hosted (our own server) | fake. No external option:
# it reads an utterance's own text, the privacy.md section 6 question #392 asks.
AUTUNE_EXTRACTION_NLI_IMPL=local
# Required for local and hosted. #172: klue/roberta-base fine-tuned on KorNLI
# (dev acc 0.8185, held-out XNLI test acc 0.8273), server-only deployment.
# mminjae97/autune-context-kornli-klue-roberta on HF Hub (private -- needs
# `hf auth login` with an invited account, or this 404s; ask 문민재 for access).
AUTUNE_EXTRACTION_NLI_CHECKPOINT=mminjae97/autune-context-kornli-klue-roberta
# Required when NLI_IMPL=hosted
AUTUNE_EXTRACTION_NLI_ENDPOINT=
# cpu or cuda, for NLI_IMPL=local. cuda needs a CUDA torch build
AUTUNE_EXTRACTION_NLI_DEVICE=cpu
# Below this confidence an item is shown as a candidate instead of asserted.
# Deliberately blank: the number has to come from the classifier's confidence
# distribution over the evaluation set (#10), which does not exist yet, and a
# value picked to populate the band would be one nobody measured. Blank means
# nothing is a candidate. See docs/modules/extraction.md.
AUTUNE_EXTRACTION_CANDIDATE_CONFIDENCE=
# Which reference resolver runs (#175): local | hosted | fake. Defaults to fake --
# unlike the classifier -- because Qwen/Qwen3-4B-Instruct-2507 is a candidate, not
# yet confirmed by #175's own Korean judgment run. fake returns each commitment's
# raw quote unchanged, the pre-#175 behaviour.
AUTUNE_EXTRACTION_RESOLVER_IMPL=fake
# Required for local and hosted. A local path/hub id, or the hosted model's version.
AUTUNE_EXTRACTION_RESOLVER_CHECKPOINT=
# Required when RESOLVER_IMPL=hosted
AUTUNE_EXTRACTION_RESOLVER_ENDPOINT=
# cpu or cuda, for RESOLVER_IMPL=local
AUTUNE_EXTRACTION_RESOLVER_DEVICE=cpu
# Which embedder backs the resolver's similarity check (#175, #366): local | fake.
# No hosted yet. Defaults to fake for the same reason RESOLVER_IMPL does.
AUTUNE_EXTRACTION_EMBEDDER_IMPL=fake
# Not blank by default -- KURE-v1 is module D's already-shipped choice, not a
# candidate awaiting evaluation. Only matters once EMBEDDER_IMPL=local and
# RESOLVER_MIN_SIMILARITY are both set.
AUTUNE_EXTRACTION_EMBEDDER_CHECKPOINT=nlpai-lab/KURE-v1
# cpu or cuda, for EMBEDDER_IMPL=local
AUTUNE_EXTRACTION_EMBEDDER_DEVICE=cpu
# Below this cosine similarity to its own context window, a resolved sentence is
# ungrounded and the raw quote is kept. Deliberately blank: no embedding model has
# been run against a labelled set of good/bad resolutions yet, so there is no
# honest number. Blank means the similarity check is skipped entirely.
AUTUNE_EXTRACTION_RESOLVER_MIN_SIMILARITY=
# true mounts /api/extraction/dev (connect Notion by hand, no auth) -- only when
# AUTUNE_ENV=local as well. Until S28 ships (#401)
AUTUNE_EXTRACTION_DEV_ROUTES=false

# --- Module C ---
AUTUNE_GAP_RISK_THRESHOLD=0.7
# Down to here is medium; below it low. Only high is surfaced by default.
AUTUNE_GAP_MEDIUM_THRESHOLD=0.5
# Which domain template a meeting nobody chose one for is compared against.
# A file in modules/gap/src/autune_gap/templates/: general | feature_planning.
AUTUNE_GAP_DEFAULT_TEMPLATE=general
# A matched topic below this carried too little of the meeting to count the
# template item as settled, so the gap is raised as partial rather than dropped.
AUTUNE_GAP_PARTIAL_CENTRALITY=0.4
# What a partial finding's score is multiplied by. "Named but thin" is a weaker
# claim than "never came up", and the metric is precision.
AUTUNE_GAP_PARTIAL_DAMPING=0.7
# The three risk inputs, relative to each other: how much the template item's
# absence matters, how thinly the meeting covered it, how much of the room was
# silent on it. Renormalised over whichever of them could be measured.
AUTUNE_GAP_WEIGHT_TEMPLATE=0.4
AUTUNE_GAP_WEIGHT_COVERAGE=0.4
AUTUNE_GAP_WEIGHT_PARTICIPATION=0.2
# Which entity extractor runs: spacy (in process) | fake.
# There is no external option -- see modules/gap pipeline.base.
AUTUNE_GAP_NER_IMPL=spacy
# The pipeline name. Its version is read from the model's own meta and recorded
# on every row; the wheel is pinned in the local-models extra, not downloaded.
AUTUNE_GAP_NER_MODEL=ko_core_news_lg
# Which relation extractor runs: rule (marker rules, in process). The only one.
# This step may grow an assisted implementation -- a relation needs the clause,
# not the transcript -- and it would go through autune_integrations (#32).
AUTUNE_GAP_RELATION_IMPL=rule
# Reads template comparison's speech by meaning as well as by keyword:
# off (keywords only, the baseline) | local (KURE-v1 in process, needs the
# local-models extra) | fake. No external option -- it reads every consenting
# utterance. Off until real meetings are measured; see docs/modules/gap.md.
AUTUNE_GAP_EMBEDDER_IMPL=off
AUTUNE_GAP_EMBEDDER_CHECKPOINT=nlpai-lab/KURE-v1
AUTUNE_GAP_EMBEDDER_DEVICE=cpu
# The cosine an utterance needs with an item's nearest example sentence, and how
# far that item must lead the runner-up (another item or the background class).
AUTUNE_GAP_SEMANTIC_FLOOR=0.55
AUTUNE_GAP_SEMANTIC_MARGIN=0
# Checks the utterances the embedder is unsure of: off | fake | gemini.
# gemini is EXTERNAL: each ambiguous utterance (masked, but not names or numbers
# read out as words) goes
# to Google with its candidate checklist items. Opt-in, dummy meetings only
# until the team decides -- see docs/modules/gap.md. Needs the embedder on.
AUTUNE_GAP_VERIFIER_IMPL=off
AUTUNE_GAP_VERIFIER_API_KEY=
AUTUNE_GAP_VERIFIER_MODEL=gemini-3.8-flash
AUTUNE_GAP_VERIFIER_FALLBACK_MODEL=gemini-3.5-flash-lite
AUTUNE_GAP_VERIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AUTUNE_GAP_VERIFIER_TIMEOUT_SEC=60
# Triage: an item winning with this score and lead is taken without asking; a
# background win by the lead is dismissed without asking; everything else with
# an item at or above the candidate score is asked about.
AUTUNE_GAP_VERIFY_CONFIDENT_SCORE=0.6
AUTUNE_GAP_VERIFY_CONFIDENT_LEAD=0.05
AUTUNE_GAP_VERIFY_CANDIDATE_SCORE=0.45
AUTUNE_GAP_VERIFY_CANDIDATES=3
AUTUNE_GAP_VERIFY_EXAMPLES=2
# At most this many utterances of one meeting leave per run.
AUTUNE_GAP_VERIFY_MAX_UTTERANCES=30

# --- Meeting Context Engine (module D) ---
# Model implementation selection. Swap to *_local (needs the local-models extra)
# or "fake" for tests. See docs/modules/context.md.
AUTUNE_CONTEXT_EMBEDDER_IMPL=kure_v1_http
AUTUNE_CONTEXT_RERANKER_IMPL=bge_reranker_v2_m3_ko_http
AUTUNE_CONTEXT_NLI_IMPL=klue_kornli_http
# Fixed at migration time as ctx_embeddings.embedding vector(N); get_embedder()
# refuses to start if the chosen model's dimension differs.
AUTUNE_CONTEXT_EMBEDDING_DIM=1024
# Self-hosted inference endpoints (settled with infra/ in Phase 0)
AUTUNE_CONTEXT_EMBEDDER_ENDPOINT=http://autune-embed.internal:8080
AUTUNE_CONTEXT_RERANKER_ENDPOINT=http://autune-rerank.internal:8080
AUTUNE_CONTEXT_NLI_ENDPOINT=http://autune-nli.internal:8080
AUTUNE_CONTEXT_EMBEDDER_TIMEOUT_S=10.0
AUTUNE_CONTEXT_RERANKER_TIMEOUT_S=10.0
AUTUNE_CONTEXT_NLI_TIMEOUT_S=10.0
# Only used by the *_local implementations (extra: local-models)
AUTUNE_CONTEXT_EMBEDDER_LOCAL_MODEL=nlpai-lab/KURE-v1
AUTUNE_CONTEXT_RERANKER_LOCAL_MODEL=dragonkue/bge-reranker-v2-m3-ko
# klue/roberta-base fine-tuned on KorNLI (dev acc 0.8185, held-out test acc
# 0.8273), at mminjae97/autune-context-kornli-klue-roberta on HF Hub (private
# -- needs `hf auth login` with an invited account, or this 404s; ask 문민재
# for access). Trained on CC BY-SA data: per #172, it runs server-only and
# the weights are never distributed.
AUTUNE_CONTEXT_NLI_LOCAL_MODEL=mminjae97/autune-context-kornli-klue-roberta
# Topic segmentation (TextTiling)
AUTUNE_CONTEXT_TOPIC_WINDOW=3
AUTUNE_CONTEXT_TOPIC_MIN_SEGMENT=3
AUTUNE_CONTEXT_TOPIC_DEPTH_THRESHOLD=0.1
# Retrieval / linking knobs
AUTUNE_CONTEXT_RETRIEVE_TOP_K=50
AUTUNE_CONTEXT_RERANK_TOP_K=10
AUTUNE_CONTEXT_RRF_K=60
AUTUNE_CONTEXT_LINK_SIMILARITY_THRESHOLD=0.74
AUTUNE_CONTEXT_LINK_CONFIDENCE_THRESHOLD=0.6
AUTUNE_CONTEXT_LINEAGE_MATCH_THRESHOLD=0.65
AUTUNE_CONTEXT_PUBLISH_TIMEOUT_S=600
AUTUNE_CONTEXT_MAX_TOPIC_LINK_NOTICES=3
AUTUNE_CONTEXT_BRIEF_LEAD_MINUTES=10
# Set only on workers that consume the cpu_heavy queue — see the setting's
# docstring in autune_context.config.
AUTUNE_CONTEXT_WARM_MODELS_ON_WORKER_INIT=false

# --- Meeting Intelligence (module E) ---
AUTUNE_INTELLIGENCE_AGGREGATE_TIMEOUT_SECONDS=600
# Which gap-pattern classifier runs: local (SetFit, in process) | fake.
# There is no external or hosted option -- see modules/intelligence pipeline.base.
AUTUNE_INTELLIGENCE_GAP_CLASSIFIER_IMPL=local
# The sentence-embedding backbone SetFit fits its few-shot head onto. Needs the
# local-models extra (uv sync --package autune-intelligence --extra local-models).
AUTUNE_INTELLIGENCE_GAP_CLASSIFIER_BACKBONE=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Set only on workers that actually aggregate meetings -- it warms the gap
# classifier and, with impl=local, fits the misalignment predictor at worker
# init. See the setting's docstring in autune_intelligence.config.
AUTUNE_INTELLIGENCE_WARM_MODELS_ON_WORKER_INIT=false
# Which misalignment predictor runs: heuristic (hand-set baseline) | local
# (XGBoost fit on labeled history, local-models extra; falls back to the
# heuristic until there is enough history). Two things must hold before local
# becomes the default, and the first is about whether the comparison can be
# trusted at all. (1) #450 is fixed: the eval scores current: on the holdout
# window and stored: on the whole training window, so the two are not one
# comparison yet. (2) The held-out current:xgb-* row beats stored:heuristic-v1 on
# Brier skill -- run the eval with this set to local, or that row does not appear
# at all. (A third condition, #445, was fixed in #453.)
# See docs/modules/intelligence.md.
AUTUNE_INTELLIGENCE_MISALIGNMENT_PREDICTOR_IMPL=heuristic
# Where the web app is served. The meeting report's details button links to
# <this>/meetings/<id>; left empty, the report is posted without the button.
AUTUNE_INTELLIGENCE_WEB_BASE_URL=
AUTUNE_INTELLIGENCE_MISALIGNMENT_REFIT_HOURS=24

# --- Agent layer (ADR 0010, docs/architecture/agent-layer.md) ---
# The chat's router: which subagent a message goes to, and the answer's wording.
# `off` switches the layer off; the fixed pipeline is unaffected. A blank key
# makes /api/agent/chat refuse with a configuration error.
AUTUNE_AGENT_ROUTER_IMPL=gemini
AUTUNE_AGENT_LLM_API_KEY=
AUTUNE_AGENT_LLM_MODEL=gemini-3.5-flash-lite
AUTUNE_AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AUTUNE_AGENT_LLM_TIMEOUT_SEC=30
# Never set LANGSMITH_TRACING or LANGCHAIN_TRACING_V2: the graph refuses to run
# with either on, because tracing sends its state past the privacy guard.
