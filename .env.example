# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every variable here is documented in docs/engineering/environments.md.

AUTUNE_ENV=local
AUTUNE_LOG_LEVEL=INFO

AUTUNE_DATABASE_URL=postgresql+psycopg://autune:autune@localhost:5432/autune
AUTUNE_REDIS_URL=redis://localhost:6379/0

# JWT signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTUNE_SECRET_KEY=local-development-only-change-me-in-every-environment

# Analysis result retention, in days (docs/architecture/privacy.md)
AUTUNE_RETENTION_DAYS=90

# --- Integrations (leave blank until the feature is built) ---
AUTUNE_SLACK_BOT_TOKEN=
AUTUNE_SLACK_SIGNING_SECRET=
# Socket mode, local development only
AUTUNE_SLACK_APP_TOKEN=
AUTUNE_NOTION_TOKEN=
AUTUNE_NOTION_DATABASE_ID=
AUTUNE_JIRA_URL=
AUTUNE_JIRA_EMAIL=
AUTUNE_JIRA_TOKEN=
AUTUNE_GOOGLE_CALENDAR_CREDENTIALS=
AUTUNE_LLM_API_KEY=

# --- Module A ---
AUTUNE_AUDIO_WHISPER_MODEL=large-v3
AUTUNE_AUDIO_DEVICE=cpu
# Raw audio lives here only while a task runs, then is deleted. Not a synced folder.
AUTUNE_AUDIO_TEMP_DIR=/tmp/autune-audio
AUTUNE_HF_TOKEN=
AUTUNE_MODEL_CACHE=~/.cache/autune/models

# --- Module C ---
AUTUNE_GAP_RISK_THRESHOLD=0.7

# --- Module D ---
# Model implementation selection. Swap to *_local (needs the local-models extra)
# or "fake" for tests. See docs/modules/context.md.
AUTUNE_CONTEXT_EMBEDDER_IMPL=kure_v1_http
AUTUNE_CONTEXT_RERANKER_IMPL=bge_reranker_v2_m3_ko_http
AUTUNE_CONTEXT_NLI_IMPL=klue_kornli_http
AUTUNE_CONTEXT_LLM_IMPL=external
# Self-hosted inference endpoints (settled with infra/ in Phase 0)
AUTUNE_CONTEXT_EMBEDDER_ENDPOINT=http://autune-embed.internal:8080
AUTUNE_CONTEXT_RERANKER_ENDPOINT=http://autune-rerank.internal:8080
AUTUNE_CONTEXT_NLI_ENDPOINT=http://autune-nli.internal:8080
# Retrieval / linking knobs
AUTUNE_CONTEXT_RETRIEVE_TOP_K=50
AUTUNE_CONTEXT_RERANK_TOP_K=10
AUTUNE_CONTEXT_LINK_CONFIDENCE_THRESHOLD=0.6
AUTUNE_CONTEXT_PUBLISH_TIMEOUT_S=600
